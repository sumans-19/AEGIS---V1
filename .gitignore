# ============================================================
# AEGIS — AI-Powered Multi-UAV Disaster Response Platform
# .gitignore
# ============================================================

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python

# Virtual Environments
backend/.venv/
backend/venv/
backend/env/
.venv/

# Python misc
backend/pip-log.txt
backend/.tox/
backend/.coverage
backend/.cache
backend/nosetests.xml
backend/coverage.xml
backend/*.db
backend/*.sqlite3

# ── Machine Learning Artifacts ────────────────────────────────
# Pre-trained models are committed; training data is NOT
backend/simulation/drone_dataset.csv
# Uncomment below to also exclude trained models from git
# backend/drone_decision_model.pkl
# backend/rl/dqn_model.pth
# yolov8n.pt

# ── Environment Secrets ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Editor / OS ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
